---
import '../styles/global.css';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';

export interface Props {
  title: string;
  description: string;
  activePage: 'home' | 'about' | 'projects';
  bodyClass?: string;
}

const {
  title,
  description,
  activePage,
  bodyClass = 'font-sans bg-slate-50 dark:bg-navy-950 text-slate-600 dark:text-slate-400 min-h-screen flex flex-col transition-colors duration-300',
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <title>{title}</title>

    <link rel="icon" id="favicon-main" type="image/svg+xml" href="/Assets/favicon/favicon.svg" />
    <link rel="apple-touch-icon" href="/Assets/favicon/apple-touch-icon.png" />
    <link rel="manifest" href="/Assets/favicon/site.webmanifest" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800;900&display=swap"
      rel="stylesheet"
    />

    <script is:inline>
      // Anti-flash theme initialization (consistent with Navbar's `color-theme` key)
      (function () {
        const stored = localStorage.getItem('color-theme');
        const prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
        if (stored === 'dark' || (!stored && prefersDark)) {
          document.documentElement.classList.add('dark');
        } else {
          document.documentElement.classList.remove('dark');
        }

        function updateFavicons(isDarkSystem) {
          const link = document.getElementById('favicon-main');
          if (!link || !link.parentNode) return;
          const suffix = isDarkSystem ? '-light' : '';
          const newHref = `/Assets/favicon/favicon${suffix}.svg`;
          const newLink = link.cloneNode(true);
          newLink.setAttribute('href', newHref);
          link.parentNode.replaceChild(newLink, link);
        }

        const mediaQuery = window.matchMedia('(prefers-color-scheme: dark)');
        mediaQuery.addEventListener('change', (e) => updateFavicons(e.matches));
        window.addEventListener('DOMContentLoaded', () => updateFavicons(mediaQuery.matches));
      })();
    </script>
  </head>

  <body class={bodyClass}>
    <Navbar activePage={activePage} />
    <slot />
    <Footer />
  </body>
</html>
