---
import { render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import TechBadges from '../../components/TechBadges.astro';
import DemoStatusButton from '../../components/DemoStatusButton.astro';
import { getAllProjectEntries, type ProjectEntry } from '../../lib/projects';
import { routes } from '../../lib/urls';

export async function getStaticPaths() {
  const entries = await getAllProjectEntries();
  return entries.map((entry) => ({
    params: { slug: entry.data.slug || entry.id },
    props: { entry },
  }));
}

interface Props {
  entry: ProjectEntry;
}

const { entry } = Astro.props;
const project = entry.data;
const { Content } = await render(entry);
const metaDescription = project.description.slice(0, 155);
---

<BaseLayout
  title={`${project.title} — Ljupce's Portfolio`}
  description={metaDescription}
  activePage="projects"
>
  <div class="flex-1 w-full bg-grid-pattern">
    <main class="flex-1 max-w-3xl mx-auto w-full px-6 py-16">
      <nav class="flex items-center gap-2 text-sm text-slate-500 dark:text-slate-500 mb-10">
        <a href={routes.home()} class="hover:text-indigo-600 dark:hover:text-indigo-400 transition-colors">Home</a>
        <span>/</span>
        <a href={routes.projects()} class="hover:text-indigo-600 dark:hover:text-indigo-400 transition-colors">
          Projects
        </a>
        <span>/</span>
        <span class="text-slate-900 dark:text-slate-200 font-medium">{project.title}</span>
      </nav>

      <header class="mb-12">
        <h1 class="text-4xl font-extrabold text-slate-900 dark:text-white mb-6 leading-tight">{project.title}</h1>
        <div class="space-y-4 text-lg text-slate-600 dark:text-slate-400 leading-relaxed">
          <Content />
        </div>
      </header>

      <section class="mb-12">
        <h2 class="text-sm font-semibold uppercase tracking-widest text-slate-400 dark:text-slate-500 mb-4">
          Technologies Used
        </h2>
        <div class="flex flex-wrap gap-2">
          <TechBadges technologies={project.technologies} size="md" />
        </div>
      </section>

      <div class="border-t border-slate-200 dark:border-slate-800 mb-12"></div>

      <section>
        <h2 class="text-sm font-semibold uppercase tracking-widest text-slate-400 dark:text-slate-500 mb-6">Links</h2>
        <div class="flex flex-wrap gap-4">
          <a
            href={project.github}
            target="_blank"
            rel="noopener noreferrer"
            class="btn-primary inline-flex items-center gap-2 bg-indigo-600 text-white px-6 py-3 rounded-lg font-semibold text-sm"
          >
            <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
              <path
                fill-rule="evenodd"
                d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.531 1.032 1.531 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z"
                clip-rule="evenodd"
              />
            </svg>
            View on GitHub
          </a>
          <DemoStatusButton demo={project.demo} demoStatusUrl={project.demoStatusUrl} variant="large" />
        </div>
      </section>
    </main>
  </div>
</BaseLayout>
